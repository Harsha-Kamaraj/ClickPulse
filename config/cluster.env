# =============================================================================
#  ClickPulse cluster configuration  (ONE file, identical on all 4 VMs)
# =============================================================================
#  1. Fill in the ZeroTier IPs (run `sudo zerotier-cli listnetworks` or
#     `ip -4 addr show | grep zt` on each VM) and the Linux username of each VM.
#  2. Commit + push, then `git pull` on every VM so all four see the same file.
#
#  Every script sources this file through scripts/lib/common.sh.
#  If you want per-VM overrides without touching git, create
#  config/cluster.local.env (it is git-ignored) with just the lines to change.
# =============================================================================

# ---- ZeroTier IPs ------------------------------------------------------------
VM1_IP="10.47.230.67"     # Harsha K  - Kafka broker 1 (+KRaft controller), broker 2, producer
VM2_IP="10.47.230.52"     # Anjanaa   - HDFS NameNode + DataNode, Airflow, Kafka consumer
VM3_IP="10.47.230.65"     # Gagan R   - Spark master + worker + driver (standalone)
VM4_IP="10.47.230.129"     # Abhishek  - Druid + dashboard

# ---- Linux login user on each VM (used by Airflow on VM2 to ssh to VM1/VM3/VM4)
VM1_USER="pes1ug24cs666"
VM2_USER="pes1ug24cs654"
VM3_USER="pes1ug24cs665"
VM4_USER="ubuntuaithal"

# ---- Cluster host aliases (written into /etc/hosts on every VM) ---------------
# Deliberately NOT the machines' real hostnames, so Ubuntu's 127.0.1.1 entry
# can never shadow them.
VM1_HOST="cp-vm1"
VM2_HOST="cp-vm2"
VM3_HOST="cp-vm3"
VM4_HOST="cp-vm4"

# ---- Install locations (same on every VM) -----------------------------------
CP_BASE="/opt/clickpulse"               # software, data dirs, logs, pids
CP_REPO="/opt/clickpulse/ClickPulse"    # this git repository

# ---- Versions -----------------------------------------------------------------
KAFKA_VERSION="3.9.0"
KAFKA_SCALA="2.13"
HADOOP_VERSION="3.3.6"
SPARK_VERSION="3.5.3"
ICEBERG_VERSION="1.6.1"
DRUID_VERSION="30.0.1"
AIRFLOW_VERSION="2.10.5"

# ---- Kafka --------------------------------------------------------------------
KAFKA_TOPIC="clickpulse.raw.clicks"        # every raw input line, unchanged
KAFKA_CONTROL_TOPIC="clickpulse.control"   # compacted: one "batch published" marker per batch
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=2                        # one replica on each broker
KAFKA_HEAP="-Xms512m -Xmx512m"             # per broker

# ---- HDFS ---------------------------------------------------------------------
HDFS_PORT=9000
HDFS_ROOT="/clickpulse"                    # raw/, rejects/, warehouse/, export/, _control/

# ---- Spark (VM3) --------------------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY="2g"
SPARK_DRIVER_MEMORY="1g"
SPARK_EXECUTOR_MEMORY="1g"

# ---- Druid (VM4) --------------------------------------------------------------
DRUID_MEMORY="6g"                          # total memory for bin/start-druid (Druid needs at least 4250m)
DRUID_DATASOURCE="clickpulse_events"
DRUID_INPUT_MODE="hdfs"                    # hdfs (spec default) | local (fallback: VM2 copies parquet to VM4)

# ---- Airflow (VM2) ------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER="admin"
AIRFLOW_ADMIN_PASSWORD="admin"

# ---- Dashboard (VM4) ----------------------------------------------------------
DASHBOARD_PORT=8501
